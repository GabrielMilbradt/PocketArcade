<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <TextView
            style="@style/Arcade.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cofre_cabecalho" />

        <TextView
            android:id="@+id/tvJogador"
            style="@style/Arcade.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            style="@style/Arcade.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_item"
            android:text="@string/cofre_instrucao" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/padding_card">

            <TextView
                style="@style/Arcade.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/legenda_verde"
                android:textColor="@color/pista_verde" />

            <TextView
                style="@style/Arcade.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/legenda_amarelo"
                android:textColor="@color/pista_amarelo" />

            <TextView
                style="@style/Arcade.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/legenda_cinza"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_item"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCodigo"
                style="@style/Arcade.Campo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/cofre_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTentar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/tentar" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTentativas"
            style="@style/Arcade.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/llFim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/padding_card"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFimTitulo"
                style="@style/Arcade.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvFimDetalhes"
                style="@style/Arcade.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNovaPartida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/nova_partida" />
        </LinearLayout>

        <TextView
            style="@style/Arcade.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_item"
            android:text="@string/historico_titulo" />

        <LinearLayout
            android:id="@+id/llHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltar"
            style="@style/Widget.Arcade.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/voltar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEncerrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/encerrar_sessao" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
