<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="@dimen/margem_tela">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="127dp"
        android:layout_height="117dp"
        android:contentDescription="@string/cd_logo"
        android:src="@drawable/ic_logo"
        app:layout_constraintBottom_toTopOf="@id/tvTitulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvTitulo"
        style="@style/Arcade.Titulo"
        android:layout_width="196dp"
        android:layout_height="43dp"
        android:layout_marginTop="12dp"
        android:text="@string/app_name"
        app:layout_constraintBottom_toTopOf="@id/tvSubtitulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo" />

    <TextView
        android:id="@+id/tvSubtitulo"
        style="@style/Arcade.Subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subtitulo_principal"
        app:layout_constraintBottom_toTopOf="@id/llAluno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

    <LinearLayout
        android:id="@+id/llAluno"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/padding_card"
        app:layout_constraintBottom_toTopOf="@id/tvApelidoLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo">

        <TextView
            android:id="@+id/tvNome"
            style="@style/Arcade.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aluno_nome"
            android:textSize="@dimen/texto_subtitulo" />

        <TextView
            android:id="@+id/tvMatricula"
            style="@style/Arcade.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aluno_matricula" />

        <TextView
            android:id="@+id/tvCurso"
            style="@style/Arcade.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aluno_curso" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvApelidoLabel"
        style="@style/Arcade.Corpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/apelido_label"
        app:layout_constraintBottom_toTopOf="@id/etApelido"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llAluno" />

    <EditText
        android:id="@+id/etApelido"
        style="@style/Arcade.Campo"
        android:layout_width="368dp"
        android:layout_height="53dp"
        android:layout_marginTop="6dp"
        android:autofillHints="username"
        android:hint="@string/apelido_hint"
        android:imeOptions="actionDone"
        android:inputType="textPersonName|textCapSentences"
        android:maxLength="20"
        app:layout_constraintBottom_toTopOf="@id/btnEntrar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvApelidoLabel" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEntrar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/entrar"
        app:layout_constraintBottom_toTopOf="@id/tvDica"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etApelido" />

    <TextView
        android:id="@+id/tvDica"
        style="@style/Arcade.Corpo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dica_individual"
        android:textSize="@dimen/texto_pequeno"
        app:layout_constraintBottom_toTopOf="@id/tvUltimoModulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnEntrar" />

    <TextView
        android:id="@+id/tvUltimoModulo"
        style="@style/Arcade.Subtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/neon_magenta"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDica" />

</androidx.constraintlayout.widget.ConstraintLayout>
