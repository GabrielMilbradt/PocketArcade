<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PocketArcade" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryVariant">@color/surface</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="colorOnSecondary">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="materialButtonStyle">@style/Widget.Arcade.Button</item>
    </style>

    <style name="Widget.Arcade.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/orange</item>
        <item name="android:textColor">@color/bg_dark</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Arcade.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/neon_cyan</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Arcade.Titulo" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Arcade.Subtitulo" parent="">
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textSize">@dimen/texto_subtitulo</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="Arcade.Corpo" parent="">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Arcade.Campo" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

</resources>
